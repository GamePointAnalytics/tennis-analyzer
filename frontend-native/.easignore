# EAS Build Upload Exclusions
# Exclude the locally-generated android folder so EAS runs expo prebuild
# on their Linux servers (correct environment, no Windows path pollution).
# The android/ folder is kept locally for local builds (npx expo run:android).
android/

# Exclude local Gradle caches
.gradle/

# Exclude node_modules (EAS installs these fresh)
node_modules/

# Exclude local build outputs
android/build/
android/app/build/
